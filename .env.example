# ==============================================================================
# ERIMAS SARL — variables d'environnement
# Copier ce fichier en `.env` (local) ou renseigner ces valeurs dans les
# "Environment Variables" de votre plateforme d'hébergement (Vercel, etc.)
# ==============================================================================

# --- Base de données (PostgreSQL — Neon, Supabase, ou instance Docker locale) ---
DATABASE_URL="postgresql://erimas:erimas@localhost:5432/erimas?schema=public"

# --- NextAuth ---
# Générer une valeur aléatoire forte : `openssl rand -base64 32`
NEXTAUTH_SECRET="changeme-generate-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Compte administrateur de démonstration (utilisé par prisma/seed.ts et /api/setup) ---
SEED_ADMIN_EMAIL="admin@erimas-tchad.com"
SEED_ADMIN_PASSWORD="ChangeMoi#2026"
SEED_ADMIN_NAME="Administration ERIMAS"

# --- Initialisation en un clic sans terminal (voir README "Déploiement sans terminal") ---
# Générer une valeur aléatoire : `openssl rand -hex 16`. Laisser vide désactive la route.
SETUP_TOKEN=""

# --- Stockage média ---
# STORAGE_DRIVER=local (par défaut, écrit dans /public/uploads — adapté au
#   développement et à un hébergement avec disque persistant)
# STORAGE_DRIVER=s3 (Cloudflare R2, Supabase Storage ou tout endpoint S3)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Site public ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
